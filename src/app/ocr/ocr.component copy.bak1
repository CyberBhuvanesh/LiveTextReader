    <!-- <video #video autoplay playsinline></video>
    <button (click)="captureFrame()">Capture</button>
    <canvas #canvas (click)="onCanvasClick($event)"></canvas> -->
    <div style="position: relative;">
        <video #video autoplay playsinline style="width: 100%;"></video>
        <!-- <canvas #overlayCanvas (click)="onOverlayClick($event)"  style="position: absolute; top: 0; left: 0; z-index: 10; width: 100%; height: 100%;"></canvas> -->
        <canvas #overlayCanvas (click)="onOverlayClick($event)"
            style="position: absolute; top: 0; left: 0; z-index: 10;" width="640" height="480"></canvas>

        <!-- </div>   <button (click)="captureFrame()">Capture</button> -->
        <canvas #processingCanvas style="display: none;"></canvas>

        <button (click)="captureFrameForOCR()">Scan Frame</button>


        


        <p *ngIf="isLoading">Scanning image...</p>
        <p *ngIf="extractedText">Extracted Text:</p>
        <pre>{{ extractedText }}</pre>
    </div>